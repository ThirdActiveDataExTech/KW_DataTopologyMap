# 편집기 공통 포맷 기준. 기존 코드 관례(공백 4칸, UTF-8)를 고정하며 일괄 재포맷은 하지 않는다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[{gradlew,*.sh}]
end_of_line = lf
