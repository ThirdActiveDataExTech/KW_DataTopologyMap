# docker compose 용 환경변수 예시. 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom
DB_USERNAME=
DB_PASSWORD=
# compose 의 thirdeye-db(PostgreSQL) 관리자 비밀번호. 최초 기동 시 위 DB_USERNAME 계정과 k_thirdeye 스키마를 만든다
POSTGRES_SUPER_PASSWORD=
# 외부 DB·Redis 를 쓰면 지정(비우면 compose 의 thirdeye-db / thirdeye-redis 사용)
#DB_URL=jdbc:postgresql://db-host:5432/dbname?currentSchema=k_thirdeye   # compose 의 thirdeye-db 대신 외부 DB 를 쓸 때
#REDIS_NODES=redis-host:6379
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MOBIGEN_URL=http://mobigen-host:30080/v1
# 메일 링크 등 외부에서 접근하는 주소(비우면 상대 경로)
BASE_URL=
# 업로드·에디터·다운로드 파일을 둘 호스트 폴더(기본 compose 파일 옆 data/)
#HOST_DATA_DIR=./data
# none: 인스턴스 메모리(Redis 불필요). redis: REDIS_NODES 의 Redis 사용, compose 내장 Redis 는 `docker compose --profile redis up -d`
SESSION_STORE_TYPE=none
COOKIE_SECURE=false
ALLOWED_ORIGINS=
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=10MB
